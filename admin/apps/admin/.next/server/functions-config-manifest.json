{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!uploads|_next\\/static|_next\\/image|icon.png|logo-.*\\.png|robots.txt).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!uploads|_next/static|_next/image|icon.png|logo-.*\\.png|robots.txt).*)"
        }
      ]
    }
  }
}
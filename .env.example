# Copy to .env for LOCAL development. Never commit .env.
# In production, set these in the Hostinger dashboard (Environment Variables), not in a file.

# First admin. Created automatically the first time an app starts on an EMPTY database.
# The password must be 12+ chars and must not contain part of the email. It has to be changed at first login.
# After that first login, DELETE ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars

# Random string, 32+ chars. Signs the admin login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Public site URL (sitemap, canonical links, Open Graph)
SITE_URL=http://localhost:3100
# Where the admin panel's "Lihat website" link goes
PUBLIC_SITE_URL=http://localhost:3100

# --- Database (MySQL / MariaDB) ---
# Local development: the portable MariaDB that `npm run dev` starts (root user, no password).
DATABASE_URL=mysql://root@127.0.0.1:3307/enjaz
# Production on Hostinger (the app and the database are on the same account, so the host is localhost):
#   DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# Special characters in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# Only if you connect across the internet: DATABASE_SSL=1 (and DATABASE_CA=<PEM> if needed).
# Optional: DATABASE_POOL_MAX=5   AUTO_MIGRATE=0 (turns off migrate-on-start)
